# SQLite для локальной разработки.
# Для Supabase: поменяйте provider в prisma/schema.prisma на "postgresql"
# и вставьте сюда connection string из Supabase (Settings -> Database).
DATABASE_URL="file:./dev.db"
PORT=3001

# Пароль для входа в админку. Если пустой — вход отключён (только для локальной разработки!).
ADMIN_PASSWORD=
# Секрет для подписи сессий (любая длинная случайная строка). Если пустой, используется ADMIN_PASSWORD.
AUTH_SECRET=
